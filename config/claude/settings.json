{
  "env": {
    "DO_NOT_TRACK": ""
  },
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); ctx=''; [ -n \"$used\" ] && ctx=$(printf ' ctx %.0f%%' \"$used\"); printf '\\033[01;32m%s@%s\\033[00m \\033[01;34m%s\\033[00m [%s]%s' \"$(whoami)\" \"$(hostname -s)\" \"$(pwd)\" \"$model\" \"$ctx\""
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "imessage@claude-plugins-official": false,
    "obsidian@obsidian-skills": true,
    "codex@openai-codex": true,
    "runpod@runpod": true,
    "typesafe@typesafe-ai": true,
    "1password@1password": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "1password": {
      "source": {
        "source": "github",
        "repo": "1Password/1password-claude-plugin"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true
}
