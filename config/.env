#!/bin/bash
function path () {
    export PATH="${PATH}:$1"
}

path "$HOME/.local/bin"
path "${HOME}/bin"
path "${HOME}/bin/metaculus"
path "${HOME}/bin/cnsl"
path "${HOME}/bin/compiled"
export EDITOR="nvim"
export TERM="xterm-256color"
export PGDATA=/opt/homebrew/var/postgresql@16
#export PATH="$DENO_INSTALL/bin:$PATH"
export DENO_INSTALL="/Users/baileywickham/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"
export DO_NOT_TRACK=1
export PGDATABASE="postgres"
export PGHOST="localhost"
export PGPASSWORD="postgres"
export PGPORT="5432"
export PGUSER="postgres"
path "${HOME}/workspace/platform/bin"
PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"

# Enable experimental Claude Code agent teams (peer-to-peer multi-agent sessions)
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# geo CLI (github.com/baileywickham/geo): Go binaries on PATH; the OpenRouteService
# key lives in 1Password and is fetched on the first `geo` call in a shell, so
# shell startup never touches 1Password and the key never sits in a dotfile.
export PATH="$HOME/go/bin:$PATH"
geo() {
    if [ -z "${ORS_API_KEY:-}" ]; then
        ORS_API_KEY="$(op --account my.1password.com read 'op://Private/OpenRouteService/credential')" || return 1
        export ORS_API_KEY
    fi
    command geo "$@"
}
